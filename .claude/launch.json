{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "elicitor",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "streamlit",
        "run",
        "knowledge-elicitation/app.py",
        "--server.port",
        "8501",
