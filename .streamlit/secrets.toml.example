# Copy to .streamlit/secrets.toml locally, or paste into the Streamlit Community
# Cloud "Secrets" box for each app. Never commit the real file.

# ---------------------------------------------------------------- LLM providers
# At least one is required. The apps show only the providers whose key is present,
# so a single-provider deployment is fine. Anthropic is the default, so that key
# is the one to set first.
ANTHROPIC_API_KEY = "sk-ant-..."
OPENAI_API_KEY = "sk-..."
GEMINI_API_KEY = "..."

# Which provider the apps start on, and optional per-role model overrides.
# Haiku 4.5 is the default: latency is a study variable (the session has a
# five-minute budget and time pressure is measured), and it runs no thinking by
# default so turns stay short and predictable.
#
# These two MUST name a model belonging to DEFAULT_PROVIDER. If you change the
# provider, change them too -- or just delete them and let the provider's own
# default apply. A mismatch is now corrected automatically and reported in the
# sidebar rather than failing every call, but the correction overrides your
# intent, so it is better to keep them in step.
DEFAULT_PROVIDER = "anthropic"
INTERVIEWER_MODEL = "claude-haiku-4-5"
CONTROL_MODEL = "claude-haiku-4-5"

# ----------------------------------------------------------------- preflight
# Before anyone is asked to consent, the Elicitor makes one tiny real call to the
# configured model, and the K-Eng does the same before the expert starts a
# ten-minute interview. If that call fails -- no credit, revoked key, wrong model
# id -- the app says so plainly instead of letting every turn fail one at a time.
#
# Leave this unset in production. Set it to "off" only to demonstrate the
# interface with no working key, in which case NO DATA SHOULD BE KEPT: every
# question falls back to the policy's own scripted wording, which is not the
# system under test. Sessions record `n_scripted_questions` so this is visible
# afterwards either way.
# PREFLIGHT = "off"

# ------------------------------------------------------------------- delivery
# Each completed session is emailed out immediately: Community Cloud has no
# durable filesystem, so anything not sent is lost on the next restart.
# For Gmail this must be a 16-character App Password, not the account password.
REPORT_FROM_EMAIL = "yourname@gmail.com"
REPORT_EMAIL_PASSWORD = "abcd efgh ijkl mnop"
REPORT_TO_EMAIL = "A.Naky@lboro.ac.uk"
SMTP_SERVER = "smtp.gmail.com"
SMTP_PORT = 465

# ------------------------------------------------------------------ researcher
# Gates the Elicitor's study controls (policy, models, arm forcing). These fail
# closed: without a PIN the controls are hidden entirely, since the Elicitor is
# reached by a public QR code.
RESEARCHER_PIN = "change-me"

# Gates the whole K-Eng app. On Streamlit Community Cloud it has a public URL and
# every screen past the setup form spends API credits. Falls back to
# RESEARCHER_PIN if unset; leave both unset only when running locally.
EXPERT_PASSCODE = "change-me-too"

# ---------------------------------------------------------------------- speech
# Optional. Off by default; enable in the researcher sidebar. Three backends can
# transcribe, tried in this order and falling through whenever one fails:
#
#   1. ElevenLabs (scribe_v1)   -- purpose-built speech-to-text, same as SPIRIT
#   2. OpenAI     (gpt-4o-transcribe)
#   3. Gemini     (multimodal)
#
# Claude accepts text, images and PDFs but not audio, so an Anthropic-only
# deployment is text-only and the sidebar says so. Any backend whose key or SDK is
# missing is skipped; if all of them fail the participant simply types, which
# always works.
ELEVENLABS_API_KEY = "..."

# Force one backend to the front of the order. The others still act as fallbacks.
# TRANSCRIBE_PROVIDER = "elevenlabs"
# TRANSCRIBE_MODEL = "scribe_v1"
