# Copy to .streamlit/secrets.toml locally, or paste into the Streamlit Community
# Cloud "Secrets" box for each app. Never commit the real file.

# ---------------------------------------------------------------- LLM providers
# At least one is required. The apps show only the providers whose key is present,
# so a single-provider deployment is fine. Anthropic is the default, so that key
# is the one to set first.
ANTHROPIC_API_KEY = "sk-ant-..."
OPENAI_API_KEY = "sk-..."
GEMINI_API_KEY = "..."

# Which provider the apps start on, and optional per-role model overrides.
# Haiku 4.5 is the default: latency is a study variable (the session has a
# five-minute budget and time pressure is measured), and it runs no thinking by
# default so turns stay short and predictable.
DEFAULT_PROVIDER = "anthropic"
INTERVIEWER_MODEL = "claude-haiku-4-5"
CONTROL_MODEL = "claude-haiku-4-5"

# ------------------------------------------------------------------- delivery
# Each completed session is emailed out immediately: Community Cloud has no
# durable filesystem, so anything not sent is lost on the next restart.
# For Gmail this must be a 16-character App Password, not the account password.
REPORT_FROM_EMAIL = "yourname@gmail.com"
REPORT_EMAIL_PASSWORD = "abcd efgh ijkl mnop"
REPORT_TO_EMAIL = "A.Naky@lboro.ac.uk"
SMTP_SERVER = "smtp.gmail.com"
SMTP_PORT = 465

# ------------------------------------------------------------------ researcher
# Gates the Elicitor's study controls (policy, models, arm forcing). These fail
# closed: without a PIN the controls are hidden entirely, since the Elicitor is
# reached by a public QR code.
RESEARCHER_PIN = "change-me"

# Gates the whole K-Eng app. On Streamlit Community Cloud it has a public URL and
# every screen past the setup form spends API credits. Falls back to
# RESEARCHER_PIN if unset; leave both unset only when running locally.
EXPERT_PASSCODE = "change-me-too"

# Optional: speech input for participants who would rather talk than type.
# Requires OPENAI_API_KEY. Off by default; enable in the researcher sidebar.
TRANSCRIBE_MODEL = "gpt-4o-transcribe"
